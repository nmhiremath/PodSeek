# PodSeek Architecture Diagram (D2)
# Re-render with:
#   d2 --layout=dagre --theme=4 docs/diagrams/architecture.d2 docs/assets/architecture-light.svg
#   d2 --layout=dagre --theme=200 docs/diagrams/architecture.d2 docs/assets/architecture-dark.svg

direction: down

classes: {
  container: {
    style: {
      stroke-width: 2
      border-radius: 8
    }
  }
  agentNode: {
    shape: rectangle
    style: {
      fill: "#3B82F6"
      font-color: "#FFFFFF"
      stroke: "#1D4ED8"
      border-radius: 6
    }
  }
  storageNode: {
    shape: cylinder
    style: {
      fill: "#E2E8F0"
      font-color: "#0F172A"
      stroke: "#64748B"
    }
  }
  externalNode: {
    shape: cloud
    style: {
      fill: "#F1F5F9"
      font-color: "#334155"
      stroke: "#94A3B8"
    }
  }
}

clients: Clients {
  class: container
  browser: "Web Browser\n(Gradio 5 Bento Studio)" {
    shape: person
  }
  apiClient: "External API Client\n(HTTP / SSE Stream)" {
    shape: page
  }
}

service: "PodSeek Application (FastAPI & LangGraph)" {
  class: container

  apiLayer: "FastAPI Routing Layer (app/api/routes.py)" {
    endpoints: "Endpoints\n/ask | /ask/stream\n/ingest | /episodes | /health"
    qaCache: "QA Cache (data/raw/qa_cache.json)\nComposite-Keyed Fast Path"
  }

  agent: "LangGraph Corrective RAG Workflow (app/agent/)" {
    class: container
    retrieve: "1. Retrieve\nCosine Distance (k=4)\nExact Quote Hoisting" {
      class: agentNode
    }
    grade: "2. Grade Documents\nSingle-Call Batch LLM\nPydantic Binary Scores" {
      class: agentNode
    }
    rewrite: "3. Rewrite Query\nSearch Query Optimizer\nCircuit Breaker (<= 2)" {
      class: agentNode
      style.fill: "#F59E0B"
      style.stroke: "#D97706"
    }
    generate: "4. Generate\nGrounded Synthesis\nTimestamp Citations [HH:MM:SS]\nRefusal Contract" {
      class: agentNode
      style.fill: "#10B981"
      style.stroke: "#059669"
    }

    retrieve -> grade: "Standard"
    retrieve -> generate: "Fast-Path (Turbo / dist < 0.35 / Quote)"
    grade -> generate: ">= 1 Relevant"
    grade -> rewrite: "0 Relevant (Retries < max)"
    rewrite -> retrieve: "Retry Search"
    grade -> generate: "Max Retries (Refusal)"
  }

  ingestion: "Ingestion Pipeline (app/ingestion/)" {
    channelGate: "Channel Guardrail\nis_huberman_channel()"
    captions: "Captions Adapter\nfetch_raw_captions()"
    chunker: "Sliding-Window Chunker\n200w target / 40w overlap"
    summarizer: "Structured Summarizer\nEpisodeAnalysis"

    channelGate -> captions -> chunker -> summarizer
  }
}

storage: "Embedded Storage Layer" {
  class: container
  chroma: "ChromaDB (chroma_db/)\n50 Huberman Episodes\n72 MB / 2,052 Vectors" {
    class: storageNode
  }
  transcripts: "Raw Transcripts (data/raw/)\n50 JSON Files\nCached Captions" {
    class: storageNode
  }
}

external: "External Providers & APIs" {
  class: container
  googleGenAI: "Google GenAI API\ngemini-3.8-flash (Chat)\ngemini-embedding-2" {
    class: externalNode
  }
  youtube: "YouTube oEmbed\n& Caption Service" {
    class: externalNode
  }
  langsmith: "LangSmith\n(Optional Tracing)" {
    class: externalNode
  }
}

# Edge connections
clients.browser -> service.apiLayer.endpoints: "HTTP / SSE"
clients.apiClient -> service.apiLayer.endpoints: "REST / Streams"

service.apiLayer.endpoints -> service.apiLayer.qaCache: "Cache Lookup"
service.apiLayer.qaCache -> service.agent: "On Cache Miss"
service.apiLayer.endpoints -> service.ingestion: "POST /ingest"

service.agent.retrieve -> storage.chroma: "Vector Cosine Search"
service.agent.grade -> external.googleGenAI: "Structured Output"
service.agent.rewrite -> external.googleGenAI: "Query Optimization"
service.agent.generate -> external.googleGenAI: "Token Streaming"

service.ingestion.channelGate -> external.youtube: "oEmbed Author Check"
service.ingestion.captions -> external.youtube: "Transcript Track"
service.ingestion.chunker -> storage.chroma: "Embed & Index Chunks"
service.ingestion.summarizer -> storage.transcripts: "Save JSON & Summaries"

service.agent -> external.langsmith: "trace_config() (Opt-In)"
